MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih-doca-verification
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
HOST=127.0.0.1

# Stripe test-mode secret key (https://dashboard.stripe.com/test/apikeys) —
# leave unset to keep the simulated Bharatkosh payment flow instead.
STRIPE_SECRET_KEY=
# Only needed for local dev, where the frontend (:5173) and backend (:5000)
# run on different ports — Stripe needs this to redirect back to the right
# one. Leave unset in production/Vercel: it's derived from the request there
# automatically, since frontend and API share one deployment domain.
FRONTEND_URL=http://localhost:5173
